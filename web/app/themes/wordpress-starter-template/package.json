{
  "name": "wordpress-starter-template",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "lint": "eslint --fix . && prettier --write .",
    "dev": "cross-env DEBUG=true webpack serve",
    "build": "cross-env DEBUG=false webpack",
    "typecheck": "tsc --noEmit"
