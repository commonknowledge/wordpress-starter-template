{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wordpress-starter-template/example",
  "title": "Example",
  "category": "theme",
  "icon": "smiley",
  "description": "An example custom block. Copy this folder to start a new block.",
  "attributes": {
    "heading": {
      "type": "string",
      "default": "Hello from a custom block"
    }
  },
  "supports": {
    "html": false
  },
  "editorScript": "file:../../build/blocks/example/index.js",
  "style": "file:../../build/blocks/example/index.css",
  "render": "file:./render.php"
}
