# Answer every *.test name with the host's loopback address, where Traefik
# listens. Other names are forwarded on, so a host that sends them here by
# mistake still resolves them.
test:53 {
    template IN A {
        answer "{{ .Name }} 60 IN A 127.0.0.1"
    }
    template IN AAAA {
        rcode NOERROR
    }
}

.:53 {
    forward . /etc/resolv.conf
}
