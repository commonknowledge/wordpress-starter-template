DB_NAME=wordpress-starter-template
DB_USER=root
DB_PASSWORD=password

# Optionally, you can use a data source name (DSN)
# When using a DSN, you can remove the DB_NAME, DB_USER, DB_PASSWORD, and DB_HOST variables
# DATABASE_URL='mysql://database_user:database_password@database_host:database_port/database_name'

DB_HOST=mysql
DB_PREFIX=wp_

# A fixed host port for MariaDB. Docker picks a free one if unset.
# DB_HOST_PORT=3308

# The site's local domain, served by the local proxy (scripts/proxy.sh).
# Docker Compose, WordPress and the scripts all read it from here.
LOCAL_DOMAIN=wordpress-starter-template.test

# Make sure that WP_HOME url does not have a trailing slash after it
WP_ENV='development'
WP_HOME="http://${LOCAL_DOMAIN}"
WP_SITEURL="${WP_HOME}/wp"
WP_DEBUG_LOG=/var/www/html/web/app/debug.log

# Generate your keys here: https://roots.io/salts.html
AUTH_KEY='generateme'
SECURE_AUTH_KEY='generateme'
LOGGED_IN_KEY='generateme'
NONCE_KEY='generateme'
AUTH_SALT='generateme'
SECURE_AUTH_SALT='generateme'
LOGGED_IN_SALT='generateme'
NONCE_SALT='generateme'
